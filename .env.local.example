# Local Docker only. Copy to .env.local and replace the sample secrets.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-only-change-this-to-a-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000/

POSTGRES_DB=globaliscdb
POSTGRES_USER=globalisc
POSTGRES_PASSWORD=local-development-password-change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public

REDIS_URL=redis://:local-redis-password-change-me@redis:6379/0
REDIS_PASSWORD=local-redis-password-change-me
CACHE_KEY_PREFIX=globaloil_local
SESSION_COOKIE_AGE=1800
SESSION_ABSOLUTE_AGE=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_LOCKOUT_SECONDS=3600

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
TRUST_X_FORWARDED_PROTO=false
TRUST_X_FORWARDED_FOR=false

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_TIMEOUT=10
