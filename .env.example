# Runtime mode
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com
FRONTEND_URL=https://app.example.com/

# PostgreSQL
POSTGRES_DB=globaliscdb
POSTGRES_USER=globalisc
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis is private to Docker. Never publish port 6379 or commit real credentials.
REDIS_URL=redis://:replace-with-a-long-random-secret@redis:6379/0
REDIS_PASSWORD=replace-with-a-long-random-secret
CACHE_KEY_PREFIX=globaloil_prod
SESSION_COOKIE_AGE=1800
SESSION_ABSOLUTE_AGE=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_LOCKOUT_SECONDS=3600

# Browser and proxy security
CORS_ALLOWED_ORIGINS=https://app.example.com
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
TRUST_X_FORWARDED_PROTO=true
TRUST_X_FORWARDED_FOR=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=true

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=replace-with-an-app-password
DEFAULT_FROM_EMAIL=notifications@example.com
EMAIL_TIMEOUT=10
